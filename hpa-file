
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cpu-stress-deployment
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cpu-stress
  template:
    metadata: 
      labels: 
        app: cpu-stress 
    spec: 
      containers:
       - name: cpu-stress-container 
         image: vish/stress         # This image generates constant CPU load 
         args: 
         - -cpus 
         - "1"       # asking container to use 1 full CPU core
         resources: 
           requests: 
             cpu: 100m              # Minimum guaranteed CPU 
           limits: 
             cpu: 500m              # Maximum CPU that will be provided 
...

---
apiVersion: autoscaling/v2 
kind: HorizontalPodAutoscaler 
metadata: 
  name: cpu-stress-hpa           # <--- HPA name 
spec: 
  scaleTargetRef: 
    apiVersion: apps/v1 
    kind: Deployment 
    name: cpu-stress-deployment  # <--- Target deployment
  minReplicas: 1                 # <--- Minimum pods 
  maxReplicas: 5                 # <--- Maximum pods 
  metrics: 
  - type: Resource 
    resource: 
      name: cpu                  # <--- Scale based on CPU 
      target: 
        type: Utilization 
        averageUtilization: 50   # <--- Target CPU usage (50%)
...
